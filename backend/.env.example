# Database (SQLite works out of the box for local dev — no Postgres install needed)
DATABASE_URL=sqlite:///./aggrow.db

# Production / Docker Postgres — uncomment and match your server credentials:
# DATABASE_URL=postgresql+psycopg2://aggrow:aggrow@localhost:5432/aggrow
#
# If you see "password authentication failed for user aggrow", either:
# - Keep DATABASE_URL as SQLite above, OR
# - Create the DB user/password/database on Postgres to match your URL, OR
# - Change DATABASE_URL to your real Postgres user (e.g. postgresql+psycopg2://YOU@localhost:5432/YOUR_DB)

# Auth
JWT_SECRET=change-me-in-production-please-make-it-long-and-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Email (SMTP) - used for order state-change notifications
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@aggrow.local
MAIL_FROM_NAME=AG Grow Orders
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_ENABLED=false

# Seeder path to the Excel catalog
CATALOG_EXCEL_PATH=../AG - ORDER FORM excel.xlsx
